#!/usr/bin/perl -w
#-------------------------------------------------------------------------------------------
# cnm-control                                                       (/opt/cnm/control/bin)
# Declarative configuration of CNM: describe how it must end up; the tool computes the
# difference with the onm database, shows it (plan) and applies it (apply).
# Design: cnm-docs, 70-Proyectos/cnm-control/PROY-CNM-cnm-control-Diseno.
# SKELETON v0.6: kinds view (create, update, parent, users), device (create, update) and latency metric
# (provision, c_label, static views). No saved plan, no queue, no audit, no deletions.
#-------------------------------------------------------------------------------------------
BEGIN { $ENV{'MIBS'}='ALL'; }		# like plite: the engine loads SNMP modules
use FindBin;
use lib "$FindBin::Bin/../lib";
use lib "/opt/crawler/bin";
use strict;
use Getopt::Long qw(GetOptionsFromArray);
use JSON;
use Fcntl qw(:flock);
use SupportDir qw(support_dir new_run_dir);
use CNMControl::Core qw(kinds validate_state make_plan apply_plan plan_text summary blocked);
use CNMControl::Profile qw(check_profile parse_inventory expand read_file);
use CNMControl::Kind::Metric;

my $VERSION     = '0.6';
my $TOOL        = 'cnm-control';
my $FILE_CONF   = '/cfg/onm.conf';
# Profiles: the ones of the installation, then the ones of the product (decision of
# 27-nov-2026). A name is looked up in that order; a path is used as it is.
my $DIR_PROFILE = '/cfg/cnm-control/profiles';
my $DIR_PROFILE_PRODUCT = "$FindBin::Bin/../profiles";

my @fpth = split ('/',$0,10);
my $USAGE = <<USAGE;
Configuracion declarativa de CNM (esqueleto v$VERSION)
(c) s30labs

$fpth[$#fpth] plan   ENTRADA [--json] [--verbose] [--cid CID]  muestra lo que cambiaria; no escribe
$fpth[$#fpth] apply  ENTRADA --confirm [--json] [--cid CID]    aplica el plan y lo comprueba
$fpth[$#fpth] expand --profile P --inventory F.csv             imprime los recursos que resultan
$fpth[$#fpth] list   views [--search TXT] | viewtypes | users | subtypes [--type latency|snmp|xagent] | fields | types | profiles
$fpth[$#fpth] check  views                                       vistas con mas de un padre (rc=1 si hay alguna)
$fpth[$#fpth] -h  : Ayuda

  ENTRADA:  -f FICHERO.json                     lista de recursos
            --profile P --inventory F.csv       perfil + CSV con ';'. Un nombre de perfil se busca en
                                                $DIR_PROFILE (instalacion) y despues en los
                                                del producto (cnm-control list profiles); o una ruta.
                                                Los ejemplos se copian a $DIR_PROFILE y se adaptan
            --set COLUMNA=VALOR                 rellena esa columna en las filas que la dejan vacia
                                                (se puede repetir; vale para todos los inventarios)
            Columnas del CSV: parametros del perfil; atributos del dispositivo sin declararlos
            (domain, type, critic, status, geodata, version, community, o device.<atributo>);
            custom.<campo>; c_label.<subtipo> (admite {name} y los demas parametros:
            --set c_label.disp_icmp="{name} - ICMP Availability"). Celda vacia = no tocar o
            el defecto del perfil. El titulo del perfil solo se pone en una metrica nueva o
            sin titulo; la columna y --set lo cambian siempre.
            Manda la celda, luego --set y luego el defecto del perfil. El dominio por defecto
            solo se usa al crear: un equipo que ya existe con esa IP y ese nombre conserva el suyo.
            Se pueden repetir y combinar: todo forma un solo plan. Cada --profile va con el
            --inventory que ocupa su mismo lugar (el primero con el primero...).
            Ejemplo: --profile views-basic --inventory vistas.csv --profile icmp-basic --inventory equipos.csv
            En una celda del CSV que va a una lista (users, views), '|' separa elementos.

  apply crea vistas (con sus padres y usuarios) y dispositivos (con su asistente y
  aplicaciones), provisiona metricas, cambia c_label y asocia metricas a vistas estaticas.
  A las vistas que ya existen les pone o cambia el padre (una vista tiene un solo padre;
  cambiarlo es moverla), les anade usuarios y les cambia type, itil_type y global. A los dispositivos que ya existen les cambia type, critic, geodata, status, SNMP
  (version 0, 1 o 2 y community) y campos de usuario (update, con el valor anterior y el
  nuevo; la community nunca se muestra; MODIFICA los cuenta por atributo). Si cambia SNMP,
  pregunta al equipo por sus datos MIB-2, como la provision. Si cambia status o SNMP,
  regenera los datos de los crawlers (lo que hace workset) antes de terminar.
  Lo que no viene en la ENTRADA (celda vacia) no se toca. No borra nada.
  Antes de aplicar, ejecutar plan con la misma ENTRADA y revisar la lista: apply vuelve a
  calcular ese mismo plan, comprueba que nadie ha cambiado los valores anteriores, lo aplica
  y, al terminar, lo calcula otra vez; si no sale vacio, termina con error. Sin --confirm, apply solo muestra el plan.
  Cada apply deja el plan, la salida del motor y el resultado en
  /store/data/support/$TOOL/runs/AAAAMMDD-HHMMSS-apply/.

  Codigo de salida: 0 bien; 1 error en el plan, al aplicar o al comprobar; 2 uso incorrecto.
USAGE

my @ARGS = @ARGV;
my $cmd = shift @ARGS;
if ((defined $cmd) && ($cmd =~ /^--?h(elp)?$/)) { print $USAGE; exit 0; }
usage("falta la orden") if (! defined $cmd);
my %o=();
GetOptionsFromArray(\@ARGS, \%o, 'f|file=s@','profile=s@','inventory=s@','set=s@','json','cid=s','confirm','search=s','type=s','verbose','h|help')
	or usage("opciones no validas");
if ($o{h}) { print $USAGE; exit 0; }
my $CID = defined $o{cid} ? $o{cid} : 'default';
usage("cid no valido") if ($CID !~ /^[\w\-]{1,20}$/);

if    ($cmd eq 'expand') { exit cmd_expand(); }
elsif ($cmd eq 'list')   { exit cmd_list(shift @ARGS); }
elsif ($cmd eq 'check')  { exit cmd_check(shift @ARGS); }
elsif ($cmd eq 'plan')   { exit cmd_plan(0); }
elsif ($cmd eq 'apply')  { exit cmd_plan(1); }
else  { usage("orden desconocida '$cmd'"); }

#===================================================================================================
sub usage { my $m=shift; print STDERR "$m\n\n$USAGE"; exit 2; }
sub fail  { my $m=shift; print STDERR "$m\n"; exit 1; }
# An input that cannot be read is reported like any other error of the plan (same header,
# same RESUMEN line, same --json), and exits with 1
sub input_error {
my $m=shift;
	output({ errors=>[ split(/\n/,$m) ], derived=>[], actions=>[], warnings=>[], unchanged=>0 }, 'entrada no valida', 'input');
	exit 1;
}

#----------------------------------------------------------------------------
# Input -> state (hash with version and resources)
#----------------------------------------------------------------------------
sub input {
	my @f   = @{$o{f}||[]};
	my @pro = @{$o{profile}||[]};
	my @inv = @{$o{inventory}||[]};
	usage("falta la entrada: -f, o --profile y --inventory") if ((! @f) && (! @pro) && (! @inv));
	usage("cada --profile necesita su --inventory (hay ".scalar(@pro)." y ".scalar(@inv).")") if (@pro != @inv);
	my %set=();
	foreach my $x (@{$o{set}||[]}) {
		usage("--set '$x': tiene que ser COLUMNA=VALOR") if ($x !~ /^([^=\s]+)=(.*)$/);
		$set{$1}=$2;
	}
	usage("--set solo vale con --profile e --inventory") if (%set && (! @pro));
	my %set_used=();
	my (@res,@origin);
	foreach my $file (@f) {
		my ($t,$e)=read_file($file); input_error($e) if ($e);
		my $d; eval { $d = JSON->new->decode($t); }; input_error("$file: JSON no valido: $@") if ($@);
		if ((@f + @pro == 1)) { return ($d, $file); }		# a single JSON file: as it is
		input_error("$file: no es un estado con \"version\": 1 y \"resources\"")
			if ((ref($d) ne 'HASH') || (! defined $d->{version}) || ($d->{version} ne '1') || (ref($d->{resources}) ne 'ARRAY'));
		my $i=0;
		foreach my $r (@{$d->{resources}}) { $i++; $r->{_origin}="$file recurso $i" if (ref($r) eq 'HASH'); push @res, $r; }
		push @origin, $file;
	}
	for my $k (0..$#pro) {
		my $rp = $pro[$k];
		if (($rp !~ m{/}) && (! -f $rp)) {		# a name: installation, then product
			usage("nombre de perfil no valido '$rp'") if ($rp !~ /^[\w][\w.\-]*$/);
			my $f = $rp.($rp =~ /\.json$/ ? '' : '.json');
			($rp) = grep { -f $_ } ("$DIR_PROFILE/$f", "$DIR_PROFILE_PRODUCT/$f");
			input_error("no hay perfil '$pro[$k]' en $DIR_PROFILE ni en los del producto (cnm-control list profiles)") if (! $rp);
		}
		my ($tp,$ep)=read_file($rp); input_error($ep) if ($ep);
		my $p; eval { $p = JSON->new->decode($tp); }; input_error("$rp: JSON no valido: $@") if ($@);
		my ($profile,$e1)=check_profile($p); input_error("$rp: $e1") if ($e1);
		my ($ti,$ei)=read_file($inv[$k]); input_error($ei) if ($ei);
		my ($rows,$e2,$u)=parse_inventory($ti,$profile,\%set); input_error(join("\n", map { "$inv[$k]: $_" } @$e2)) if (@$e2);
		$set_used{$_}=1 foreach (keys %$u);
		my ($r,$e3)=expand($profile,$rows,$inv[$k]); input_error(join("\n",@$e3)) if (@$e3);
		push @res, @$r;
		push @origin, "perfil $rp + $inv[$k] (".scalar(@$rows)." filas)";
	}
	my @unused = grep { ! $set_used{$_} } sort keys %set;
	input_error("--set ".join(', ',@unused).": ninguna entrada tiene esa columna (parametro del perfil, atributo del dispositivo, custom.<campo> o c_label.<subtipo>)") if (@unused);
	return ({ version=>1, resources=>\@res }, join('; ',@origin).(%set ? ' --set '.join(',', sort keys %set) : ''));
}

#----------------------------------------------------------------------------
# Context: connection to the onm database and the provisioning engine (loaded only when needed)
#----------------------------------------------------------------------------
sub context {
	require ONMConfig; require Crawler::Store;
	my $rcfg = ONMConfig::conf_base($FILE_CONF);
	fail("no se puede leer $FILE_CONF") if (ref($rcfg) ne 'HASH');
	my $store = Crawler::Store->new(store_path=>$rcfg->{'store_path'}->[0],
		db_server=>$rcfg->{'db_server'}->[0], db_name=>$rcfg->{'db_name'}->[0],
		db_user=>$rcfg->{'db_user'}->[0], db_pwd=>$rcfg->{'db_pwd'}->[0], log_level=>'info');
	my $dbh = $store->open_db();
	fail("no se puede conectar con la base de datos") if (! $dbh);
	$dbh->{RaiseError}=1; $dbh->{PrintError}=0;
	my ($prov,$ip);
	return { dbh=>$dbh, cid=>$CID, cache=>{}, pending=>{},
				# IP of the interface of /cfg/onm.if: cid_ip of the views this tool creates
				local_ip => sub {
					return $ip if (defined $ip);
					open(my $se,'>&',\*STDERR); open(STDERR,'>','/dev/null');		# lsb_release writes to stderr
					$ip = eval { ONMConfig::my_ip() };
					open(STDERR,'>&',$se);
					return $ip;
				},
				provision => sub {
					return $prov if ($prov);
					require ProvisionLite;
					$prov = ProvisionLite->new(log_level=>'info', log_mode=>3, cfg=>$rcfg);
					$prov->init();
					return $prov;
				} };
}

#----------------------------------------------------------------------------
sub cmd_expand {
	my ($d,$origin)=input();
	print JSON->new->canonical(1)->pretty->encode($d);
	return 0;
}

#----------------------------------------------------------------------------
sub cmd_plan {
my ($do_apply)=@_;
	my ($d,$origin)=input();
	my ($by_kind,$err,$der)=validate_state($d);
	if (@$err) { output({ errors=>$err, derived=>$der, actions=>[], warnings=>[], unchanged=>0 }, $origin, 'validate'); return 1; }
	my $ctx = context();
	my $plan = make_plan($ctx,$by_kind);
	output($plan, $origin, 'plan');
	return 1 if (blocked($plan));
	return 0 if (! $do_apply || ! @{$plan->{actions}});
	usage("apply: falta --confirm; no se ha aplicado nada") if (! $o{confirm});

	my $state_dir = eval { support_dir($TOOL,'state',1) }; fail("directorio de estado: $@") if ($@);
	open(my $lock,'>',"$state_dir/apply.lock") or fail("no se puede abrir $state_dir/apply.lock: $!");
	flock($lock, LOCK_EX|LOCK_NB) or fail("hay otro cnm-control aplicando (bloqueo $state_dir/apply.lock)");
	my $run = eval { new_run_dir($TOOL,'apply') }; fail("directorio de la ejecucion: $@") if ($@);
	write_json("$run/plan.json", { origin=>$origin, cid=>$CID, actions=>public_actions($plan), warnings=>$plan->{warnings} });

	# The engine writes to standard output: during apply it goes to the run directory
	open(my $out_orig,'>&',\*STDOUT); open(my $err_orig,'>&',\*STDERR);
	open(STDOUT,'>>',"$run/engine.log"); open(STDERR,'>>',"$run/engine.log");
	my $e = eval { apply_plan($ctx,$plan) }; my $ex=$@;
	open(STDOUT,'>&',$out_orig); open(STDERR,'>&',$err_orig);
	$e = [ "excepcion: $ex" ] if ($ex);

	# Check: the plan, computed again, must be empty
	my $ctx2 = context();
	my $plan2 = make_plan($ctx2,$by_kind);
	my $ok = (! @$e) && (! @{$plan2->{actions}}) && (! blocked($plan2));
	my $result = { applied=>($ok?JSON::true:JSON::false), apply_errors=>$e, apply_warnings=>($ctx->{apply_warnings}||[]),
						pending=>public_actions($plan2), check_errors=>[ @{$plan2->{errors}}, @{$plan2->{derived}} ], run_dir=>$run };
	write_json("$run/result.json", $result);
	if ($o{json}) { print JSON->new->canonical(1)->pretty->encode($result); }
	else {
		print "APLICAR\n", (map { "  ERROR  $_\n" } @$e), (map { "  AVISO  $_\n" } @{$ctx->{apply_warnings}||[]});
		print "COMPROBACION (plan calculado otra vez)\n", plan_text($plan2,$o{verbose});
		print $ok ? "RESULTADO OK ($run)\n" : "RESULTADO ERROR: no ha quedado como se pedia (detalle en $run)\n";
	}
	return $ok ? 0 : 1;
}

# Actions as they are written (--json, plan.json, result.json): without the resource, and
# without the value of the SNMP community, before or after (the apply keeps it in memory)
sub public_actions {
my $p=shift;
	return [ map { my %a=%$_; delete $a{resource};
						if ($a{changes} && $a{changes}{community}) { $a{changes} = { %{$a{changes}}, community=>['****','****'] }; }
						\%a } @{$p->{actions}} ];
}

sub write_json {
my ($path,$data)=@_;
	open(my $fh,'>',"$path.tmp") or return;
	print $fh JSON->new->canonical(1)->pretty->encode($data);
	close($fh) and rename("$path.tmp",$path);
}

sub output {
my ($plan,$origin,$phase)=@_;
	if ($o{json}) {
		print JSON->new->canonical(1)->pretty->encode({ phase=>$phase, origin=>$origin, cid=>$CID,
			actions=>public_actions($plan), errors=>$plan->{errors}, derived_errors=>$plan->{derived},
			blocked=>(blocked($plan)?JSON::true:JSON::false), warnings=>$plan->{warnings}, summary=>summary($plan) });
	}
	else { print "PLAN - $origin - cid=$CID\n", plan_text($plan,$o{verbose}); }
}

#----------------------------------------------------------------------------
#----------------------------------------------------------------------------
# check views: a view has one parent; list the ones with more (exit 1 if any)
#----------------------------------------------------------------------------
sub cmd_check {
my ($what)=@_;
	usage("check: views") if ((! defined $what) || ($what ne 'views'));
	my $ctx = context(); my $dbh=$ctx->{dbh};
	my $rows = $dbh->selectall_arrayref(
		"SELECT s.name, s.id_cfg_view, GROUP_CONCAT(p.name ORDER BY p.name SEPARATOR ' | ') FROM cfg_views2views a ".
		"JOIN cfg_views s ON s.id_cfg_view=a.id_cfg_subview JOIN cfg_views p ON p.id_cfg_view=a.id_cfg_view ".
		"WHERE a.cid_view=? AND a.cid_subview=? GROUP BY s.id_cfg_view, s.name HAVING COUNT(*) > 1 ORDER BY s.name", undef, $CID, $CID);
	if (! @$rows) { print "check views: ninguna vista con mas de un padre (cid=$CID)\n"; return 0; }
	print "check views: ".scalar(@$rows)." vistas con mas de un padre (cid=$CID); una vista tiene un solo padre:\n";
	printf("  %-50s id %-6s padres: %s\n", @$_) foreach (@$rows);
	return 1;
}

#----------------------------------------------------------------------------
# list profiles: installation first; a product profile with the same name is hidden
#----------------------------------------------------------------------------
sub list_profiles {
	my %seen=();
	printf("%-24s %-18s %s\n", 'perfil', 'origen', 'descripcion');
	foreach my $d ([$DIR_PROFILE,'instalacion'], [$DIR_PROFILE_PRODUCT,'producto'], ["$DIR_PROFILE_PRODUCT/examples",'ejemplo']) {
		opendir(my $dh, $d->[0]) or next;
		foreach my $f (sort grep { /\.json$/ && -f "$d->[0]/$_" } readdir($dh)) {
			(my $n = $f) =~ s/\.json$//;
			my ($t) = read_file("$d->[0]/$f");
			my $p = eval { JSON->new->decode($t) } || {};
			my $descr = (ref($p) eq 'HASH' && defined $p->{descr}) ? $p->{descr} : '';
			$descr = substr($descr,0,90).'...' if (length($descr) > 93);
			my $origin = ($d->[1] eq 'ejemplo') ? 'ejemplo' : ($seen{$n} ? "$d->[1] (oculto)" : $d->[1]);
			printf("%-24s %-18s %s\n", $n, $origin, $descr);
			$seen{$n}=1 if ($d->[1] ne 'ejemplo');
		}
		closedir($dh);
	}
	print "(oculto: hay uno de la instalacion con el mismo nombre, y manda ese. Un ejemplo no se usa por\n".
			" su nombre: se copia a $DIR_PROFILE y se adapta)\n";
	return 0;
}

sub cmd_list {
my ($what)=@_;
	usage("list: views | viewtypes | users | subtypes | fields | types | profiles") if (! defined $what);
	usage("list: views | viewtypes | users | subtypes | fields | types | profiles") if ($what !~ /^(views|viewtypes|users|subtypes|fields|types|profiles)$/);
	return list_profiles() if ($what eq 'profiles');
	my $ctx = context(); my $dbh=$ctx->{dbh};
	my @rows=(); my @head=();
	if ($what eq 'views') {
		my $sql="SELECT name,id_cfg_view,IF(live_metric=1,'viva','estatica'),nmetrics FROM cfg_views WHERE cid=?";
		my @b=($CID);
		if (defined $o{search}) { $sql.=" AND name LIKE ?"; push @b, '%'.$o{search}.'%'; }
		@head=('vista','id','clase','metricas');
		@rows=@{ $dbh->selectall_arrayref("$sql ORDER BY name", undef, @b) };
	}
	elsif ($what eq 'subtypes') {
		my $cat = CNMControl::Kind::Metric->catalog($ctx);
		@head=('subtipo','tipo','lapse');
		@rows = map { [ $_, $cat->{$_}{type}, $cat->{$_}{lapse} ] }
				  grep { (! defined $o{type}) || ($cat->{$_}{type} eq $o{type}) } sort keys %$cat;
	}
	elsif ($what eq 'viewtypes') { @head=('tipo de vista'); @rows=@{ $dbh->selectall_arrayref("SELECT name FROM cfg_views_types ORDER BY name") }; }
	elsif ($what eq 'users')     { @head=('usuario','descripcion'); @rows=@{ $dbh->selectall_arrayref("SELECT login_name,descr FROM cfg_users ORDER BY login_name") }; }
	elsif ($what eq 'fields') { @head=('campo de usuario'); @rows=@{ $dbh->selectall_arrayref("SELECT descr FROM devices_custom_types ORDER BY descr") }; }
	else                      { @head=('tipo de dispositivo'); @rows=@{ $dbh->selectall_arrayref("SELECT descr FROM cfg_host_types ORDER BY descr") }; }
	if ($o{json}) { print JSON->new->canonical(1)->pretty->encode([ map { my $f=$_; +{ map { $head[$_] => $f->[$_] } 0..$#head } } @rows ]); }
	else { print join("\t",@head),"\n"; print join("\t", map { defined $_ ? $_ : '' } @$_),"\n" foreach (@rows); }
	return 0;
}

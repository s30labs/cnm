sub usage { my ($m)=@_; print STDERR "$m\n" if ($m); print STDERR "Ayuda: $NAME -h\n"; exit 2; }
sub fail  { my ($m)=@_; print STDERR "ERROR: $m\n"; return 1; }
sub step  { my ($m)=@_; print(($DRY ? '[dry-run] ' : '')."$m\n"); }

sub db {
	return if ($DBH);
	require ONMConfig; ONMConfig->import();
	require Crawler::Store;
	my $rcfg = ONMConfig::conf_base($FILE_CONF);
	$STORE = Crawler::Store->new(store_path=>$rcfg->{'store_path'}->[0],
		db_server=>$rcfg->{'db_server'}->[0], db_name=>$rcfg->{'db_name'}->[0],
		db_user=>$rcfg->{'db_user'}->[0], db_pwd=>$rcfg->{'db_pwd'}->[0], log_level=>'info');
	$DBH = $STORE->open_db();
	die "No se puede conectar con la base\n" if (! $DBH);
	$DBH->{'RaiseError'}=1;
}

sub read_file {
my $f=shift;
	my $fh;
	open($fh,'<',$f) or return undef;
	local $/;
	my $t=<$fh>;
	close($fh);
	return $t;
}

# Escribe en un temporal del mismo directorio y hace rename, conservando dueno y permisos
sub write_file {
my ($f,$text)=@_;
	my $tmp="$f.cnm-testbed.$$";
	my $fh;
	open($fh,'>',$tmp) or die "No se puede escribir $tmp: $!\n";
	print $fh $text;
	close($fh) or die "No se puede escribir $tmp: $!\n";
	my @st = stat($f);
	if (@st) { chmod($st[2] & 07777, $tmp); chown($st[4], $st[5], $tmp); }
	rename($tmp,$f) or die "No se puede renombrar $tmp: $!\n";
}

sub json_read  { my $t=read_file(shift); return (defined $t) ? JSON->new->decode($t) : undef; }
sub json_write { my ($f,$d)=@_; write_file($f, JSON->new->canonical->pretty->encode($d)); }

sub state      { return json_read($FILE_STATE); }
sub save_state { my $s=shift; json_write($FILE_STATE,$s) if (! $DRY); }

# Ejecuta una orden; la salida va a un fichero de log. Devuelve el rc (leido sin tuberia).
sub run_cmd {
my ($show,$log,@cmd)=@_;
	step("  \$ $show".((defined $log) ? "   (salida en $log)" : ''));
	return 0 if ($DRY);
	my $pid = fork();
	die "fork: $!\n" if (! defined $pid);
	if ($pid == 0) {
		if (defined $log) { open(STDOUT,'>>',$log); open(STDERR,'>&',\*STDOUT); }
		exec(@cmd) or exit 127;
	}
	waitpid($pid,0);
	return $? >> 8;
}

sub plite {
my ($id,@args)=@_;
	my $log = "$RUN/log/plite-".strftime('%Y%m%d-%H%M%S',localtime()).".log";
	my $rc = run_cmd("$PLITE -r $id @args", $log, $PLITE, '-r', $id, @args);
	die "plite ha devuelto $rc; ver $log\n" if ($rc != 0);
}

sub monitor_key { my $subtype=shift; return "s_$subtype-".substr(md5_hex("cnm-testbed $subtype"),0,8); }

sub device {
my $id=shift;
	db();
	my $r = $DBH->selectrow_hashref("SELECT id_dev,name,ip,version,community FROM devices WHERE id_dev=?", undef, $id);
	die "No existe el equipo $id\n" if (! $r);
	return $r;
}

#-------------------------------------------------------------------------------------------
# Fotos
#-------------------------------------------------------------------------------------------
sub collect {
my $id=shift;
	db();
	my %s=( id_dev=>$id, taken=>time(), parents=>{}, template=>{}, metrics=>{}, blue=>[] );
	my $r = $DBH->selectall_arrayref("SELECT id_template_metric,id_dev,id_dest,lapse,type,subtype FROM prov_template_metrics WHERE id_dev=?", { Slice=>{} }, $id);
	$s{'parents'}{$_->{'subtype'}} = $_ foreach (@$r);
	$r = $DBH->selectall_arrayref("SELECT t.id_template_metric,t.id_dev,t.id_dest,t.iid,t.hiid,t.mname,t.watch,t.label,t.status,p.subtype "
		."FROM prov_template_metrics2iid t JOIN prov_template_metrics p ON t.id_template_metric=p.id_template_metric WHERE p.id_dev=?", { Slice=>{} }, $id);
	$s{'template'}{"$_->{'subtype'}|$_->{'iid'}"} = $_ foreach (@$r);
	$r = $DBH->selectall_arrayref("SELECT name,subtype,iid,c_label,watch,status FROM metrics WHERE id_dev=?", { Slice=>{} }, $id);
	$s{'metrics'}{$_->{'name'}} = $_ foreach (@$r);
	$r = $DBH->selectcol_arrayref("SELECT DISTINCT mname FROM alerts WHERE id_device=? AND severity=4", undef, $id);
	$s{'blue'} = [ sort @$r ];
	($s{'qactions_max'}) = $DBH->selectrow_array("SELECT COALESCE(MAX(id_qactions),0) FROM qactions");
	return \%s;
}

sub snap_file { my $n=shift; return "$RUN/snapshots/$n.json"; }

sub take_snapshot {
my ($id,$name)=@_;
	my $s = collect($id);
	step("Foto \"$name\": ".scalar(keys %{$s->{'template'}})." filas de plantilla, "
		.scalar(keys %{$s->{'metrics'}})." metricas, ".scalar(@{$s->{'blue'}})." azules");
	json_write(snap_file($name),$s) if (! $DRY);
	return $s;
}

sub load_snapshot {
my $name=shift;
	my $s = json_read(snap_file($name));
	die "No existe la foto $name (".snap_file($name).")\n" if (! $s);
	return $s;
}

#-------------------------------------------------------------------------------------------
# snmpd
#-------------------------------------------------------------------------------------------
sub snmpd_set {
my ($name,$lines)=@_;
	my $text = read_file($SNMPD_CONF);
	die "No se puede leer $SNMPD_CONF\n" if (! defined $text);
	if ((! $DRY) && (! -e "$RUN/snmpd.conf.copied")) {
		my $b = support_dir($TOOL,'backup',1).'/snmpd.conf.'.strftime('%Y%m%d-%H%M%S',localtime());
		copy($SNMPD_CONF,$b) or die "copia de $SNMPD_CONF en $b: $!\n";
		write_file("$RUN/snmpd.conf.copied", "$b\n");
		step("  copia previa: $b");
	}
	my $new = (defined $lines) ? set_block($text,$name,$lines) : remove_block($text,$name);
	return 0 if ($new eq $text);
	step("$SNMPD_CONF: ".((defined $lines) ? "bloque cnm-testbed:$name" : "sin el bloque cnm-testbed:$name"));
	write_file($SNMPD_CONF,$new) if (! $DRY);
	return 1;
}

# Como lo hace CNM (cnm-watch, cnm-daily, el rol net-snmp): con el script de init, no con
# systemctl. Despues comprueba que snmpd sigue vivo (si la configuracion es mala, el
# recorrido de la tabla lo dira) y espera a que responda $CPU_OID ($dev: el equipo).
sub snmpd_restart {
my ($dev,$nowait)=@_;
	my $rc = run_cmd("$SNMPD_INIT restart", undef, $SNMPD_INIT, 'restart');
	die "$SNMPD_INIT restart ha devuelto $rc\n" if ($rc != 0);
	return if ($DRY);
	sleep(2);
	die "snmpd no esta en marcha despues de reiniciarlo\n" if (! snmpd_running());
	snmpd_wait_cpu($dev) if (! $nowait);
}

sub snmpd_running { return (system("pgrep -x snmpd >/dev/null 2>&1") == 0) ? 1 : 0; }

# 1 si $CPU_OID responde con un valor (no "No Such Instance/Object", ni error)
sub cpu_ready {
my $dev=shift;
	my $v = ($dev->{'version'} eq '1') ? '1' : '2c';
	local $ENV{'MIBS'}='ALL';
	my $fh;
	open($fh,'-|',$SNMPGET,"-v$v",'-c',$dev->{'community'},$dev->{'ip'},$CPU_OID) or die "$SNMPGET: $!\n";
	my @l = <$fh>;
	close($fh);
	return (($? == 0) && (grep { /^\Q$CPU_OID\E = INTEGER: \d+/ } @l)) ? 1 : 0;
}

sub snmpd_wait_cpu {
my $dev=shift;
	db();
	my $rows = $DBH->selectall_arrayref("SELECT p.subtype, t.status, c.enterprise, c.oid FROM prov_template_metrics2iid t JOIN prov_template_metrics p USING(id_template_metric) JOIN cfg_monitor_snmp c ON c.subtype=p.subtype WHERE t.id_dev=?", { Slice=>{} }, $dev->{'id_dev'});
	die "no se puede leer la plantilla del equipo $dev->{'id_dev'}: ".$DBH->errstr."\n" if (! $rows);
	my @ucd = ucd_subtypes_in_use($rows);
	if (! @ucd) { step("  sin subtipos UCD (empresa 2021) activos en la plantilla: no se espera"); return 1; }
	step("  subtipos UCD en la plantilla: ".join(' ',@ucd));
	step("  esperando a que snmpd responda $CPU_OID (un minuto de historia de CPU; maximo $CPU_WAIT s)");
	my $t0 = time();
	while (time() - $t0 < $CPU_WAIT) {
		if (cpu_ready($dev)) { step("  responde a los ".(time()-$t0)." s"); return 1; }
		sleep($CPU_STEP);
	}
	step("  AVISO: $CPU_OID no responde tras $CPU_WAIT s; una provision ahora puede quitar ucd_cpu_usage");
	return 0;
}

# Recorre la columna de etiquetas como lo hace la provision. Devuelve (rc, n filas).
sub walk_labels {
my $dev=shift;
	my $v = ($dev->{'version'} eq '1') ? '1' : '2c';
	step("  \$ $SNMPWALK -v$v -c *** $dev->{'ip'} CNM-TESTBED-MIB::cnmTestbedLabel");
	return (0,-1) if ($DRY);
	local $ENV{'MIBS'}='ALL';
	my $fh;
	open($fh,'-|',$SNMPWALK,"-v$v",'-c',$dev->{'community'},$dev->{'ip'},'CNM-TESTBED-MIB::cnmTestbedLabel') or die "$SNMPWALK: $!\n";
	my @l = <$fh>;
	close($fh);
	my $rc = $? >> 8;
	my $n = scalar(grep { /^CNM-TESTBED-MIB::cnmTestbedLabel\.\d+ = / } @l);
	return ($rc,$n);
}


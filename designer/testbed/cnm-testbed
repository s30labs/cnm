#!/usr/bin/perl -w
#-------------------------------------------------------------------------------------------
# cnm-testbed
# Monta en un CNM de pruebas un entorno controlado para probar la provision: el propio
# equipo monitorizado por SNMP, una tabla de prueba servida por cnm-testbed-agent, monitores
# y c_label en sus instancias, y fotos del estado para comparar y volver atras.
# Solo para equipos de pruebas. Diseno: cnm-docs, PROY-CNM-Alertas-Azules §6.
#-------------------------------------------------------------------------------------------
use lib "/opt/crawler/bin";
use strict;
use FindBin;
use lib "$FindBin::Bin/lib";
use Getopt::Long qw(GetOptionsFromArray);
use JSON;
use Digest::MD5 qw(md5_hex);
use File::Copy qw(copy);
use POSIX qw(strftime);
use SupportDir qw(support_dir new_run_dir);
use Testbed::Agent qw(parse_scenario check_scenario scenario_text);
use Testbed::SnmpdConf qw(has_block set_block remove_block block_names);
use Testbed::Snapshot qw(diff_snapshots diff_is_empty diff_lines restore_plan);
use Testbed::Ucd qw(ucd_subtypes_in_use);
use Testbed::Engine qw(parse_ps crawlers stale_crawlers);
use Testbed::Battery qw(select_cases parse_modes expected set_guard_line evaluate split_blues NOTICE_SKIP NOTICE_REREAD);

my $FILE_CONF   = '/cfg/onm.conf';
# Donde escribe (REF-CNM-Estilo-Scripts §2.9, SupportDir.pm):
#   state/   state.json, agent.conf y agent.reads (el agente lee de aqui)
#   backup/  snmpd.conf antes de cambiarlo
#   runs/AAAAMMDD-HHMMSS-session/  una sesion de setup a teardown: snapshots/ y log/.
#            Lleva KEEP mientras la sesion esta abierta, para que no la purgue cnm-daily.
my $TOOL        = 'cnm-testbed';
my $DIR         = support_dir($TOOL,'state');
my $FILE_STATE  = "$DIR/state.json";
my $RUN;	# la sesion en curso: runs/AAAAMMDD-HHMMSS-session
my $SNMPD_CONF  = '/etc/snmp/snmpd.conf';
my $MIB_SRC     = "$FindBin::Bin/CNM-TESTBED-MIB.txt";
my $MIB_DST     = '/opt/data/app-data/mibs_private/CNM-TESTBED-MIB.txt';
my $AGENT       = "$FindBin::Bin/cnm-testbed-agent";
my $PLITE       = '/opt/crawler/bin/plite';
my $SNMPWALK    = '/usr/local/bin/snmpwalk';	# el mismo que usa snmp_get_iid (Crawler/SNMP.pm)
my $SNMPGET     = '/usr/local/bin/snmpget';
# Tras reiniciar snmpd, los valores de UCD-SNMP-MIB calculados sobre el ultimo minuto no
# responden hasta que el agente tiene un minuto de historia (net-snmp:
# agent/mibgroup/ucd-snmp/vmstat.c, "only be reported once the agent has a full minute's
# history"; muestras cada 5 s en hardware/cpu/cpu.c). Todos dependen de la misma historia,
# asi que basta con preguntar uno. Solo se espera si el equipo usa subtipos UCD (Testbed::Ucd).
my $CPU_OID     = 'UCD-SNMP-MIB::ssCpuIdle.0';
my $CPU_WAIT    = 120;	# segundos como maximo
my $CPU_STEP    = 5;
my $SUBTYPE     = 'cnm_testbed_rows';
my $TMPFS       = '/mnt/cnm-testbed';
my $TABLE_OID   = '.1.3.6.1.4.1.8072.9999.9999.7';
my $CNMD_INIT   = '/etc/init.d/cnmd';	# arranque y parada del motor (REF-CNM-Funcionamiento §1.3)
my $STOP_ENGINE = '/cfg/stop-cnm-engine';
# cnmd start no arranca nada (cnmd.init:90-93): el motor lo levanta cnm-watch, cada 2 minutos
# desde /etc/cron.fast. Se para con stop (SIGTERM) y, si a los $STOP_WAIT s sigue algun
# crawler viejo, con kill (kill -9), como se hace a mano cuando hay muchos procesos.
my $STOP_WAIT   = 60;
my $KILL_WAIT   = 30;
my $ENGINE_WAIT = 300;	# segundos como maximo hasta que cnm-watch levante los crawlers
my $BLUE_WAIT   = 400;	# battery: segundos como maximo para que el crawler quite las azules de la tabla de prueba
my $SNMPD_INIT  = '/etc/init.d/snmpd';	# CNM arranca snmpd con su script (roles/net-snmp/tasks/main.yml:170)
#-------------------------------------------------------------------------------------------
my @fpth = split ('/',$0,10);
my $NAME = $fpth[$#fpth];
my $USAGE = <<USAGE;
Entorno de pruebas de la provision en un CNM de pruebas (el propio equipo, por SNMP)
(c) s30labs

$NAME setup    [--id ID] [--rows N] [--dry-run]   prepara el entorno y hace las fotos "pre" y "base"
$NAME status                                       que esta montado y que falta
$NAME agent    [--mode M] [--rows N] [--cut-at K] [--drop 2,4] [--delay S]
                                                   cambia el escenario de la tabla de prueba
$NAME snapshot NAME                                foto del estado del equipo
$NAME diff     NAME [NAME2]                        diferencias entre una foto y otra, o el estado actual
$NAME restore  NAME [--dry-run]                    vuelve al estado de una foto
$NAME teardown [--dry-run]                         lo deshace todo y vuelve a la foto "pre"

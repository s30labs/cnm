my @ARGS = @ARGV;
my $CMD = shift @ARGS;
if ((! defined $CMD) || ($CMD eq '-h')) { print $USAGE; exit((defined $CMD) ? 0 : 2); }

my %o=();
GetOptionsFromArray(\@ARGS, \%o, 'id=i','rows=i','dry-run','mode=s','cut-at=i','drop=s','delay=i','guard=s','case=s')
	or usage();

my %CMDS = ( setup=>\&cmd_setup, status=>\&cmd_status, agent=>\&cmd_agent, snapshot=>\&cmd_snapshot,
				 diff=>\&cmd_diff, restore=>\&cmd_restore, teardown=>\&cmd_teardown, battery=>\&cmd_battery );
usage("orden desconocida: $CMD") if (! $CMDS{$CMD});
my @NAMES = @ARGS;
usage("falta NAME") if ((($CMD eq 'snapshot') || ($CMD eq 'diff') || ($CMD eq 'restore')) && (! @NAMES));
usage("sobran argumentos: @NAMES") if ((($CMD eq 'snapshot') || ($CMD eq 'restore')) && (@NAMES > 1));
usage("sobran argumentos: @NAMES") if (($CMD eq 'diff') && (@NAMES > 2));
usage("sobran argumentos: @NAMES") if ((grep { $CMD eq $_ } qw(setup status agent teardown battery)) && (@NAMES));
usage("--guard y --case solo valen con battery") if (($CMD ne 'battery') && ((defined $o{'guard'}) || (defined $o{'case'})));
foreach my $n (@NAMES) { usage("nombre de foto no valido: $n (letras, numeros, - y _)") if ($n !~ /^[\w-]+$/); }

my ($STORE,$DBH);
my $DRY = $o{'dry-run'} ? 1 : 0;
if ($CMD ne 'setup') { my $st0 = state(); $RUN = $st0->{'run_dir'} if ($st0); }
my $RC = eval { $CMDS{$CMD}->() };
if (! defined $RC) { print STDERR "ERROR: $@"; $RC = 1; }
exit $RC;


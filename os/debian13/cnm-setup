#-------------------------------------------------------------------------------------------
#-------------------------------------------------------------------------------------------
sub update_repo {
my ($feature) = @_;

   if (! -d "/opt/$feature") { return; }
   if (! -f "/opt/$feature/.git/config") { return; }

   open (F,"</opt/$feature/.git/config");
   #url = https://software.s30labs.com/cnm.git
   while (<F>) {
      chomp;
      if ($_ =~ /software\.s30labs\.com/) {
         if (! -d '/store/old_repo') { `/bin/mkdir /store/old_repo`; }
         `/bin/mv /opt/$feature /store/old_repo/`;
         print "**** $feature -> /store/old_repo/ ****\n";
         last;
      }
   }
   close F;

}

#-------------------------------------------------------------------------------------------
# Asegura las variables de TimescaleDB en /cfg/cnm_vars.yml (idempotente)
#-------------------------------------------------------------------------------------------
sub ensure_cnm_vars {
   my $dir='/cfg';
   my $file="$dir/cnm_vars.yml";
   if (! -d $dir) { system("/bin/mkdir","-p",$dir); }

   # Config NO secreta de TimescaleDB
   my @cfg = (
      ['pg_version','17'],
      ['ts_db','obs'],
      ['ts_user','cnm_loader'],
      ['spool_path','/opt/data/spool/ts'],
      ['crawler_user','root'],
      ['install_loader_service','false'],
   );

   my %have;
   if (-f $file) {
      open(my $fh,'<',$file) or die "No puedo leer $file: $!\n";
      while (<$fh>) { $have{$1}=1 if /^(\w[\w-]*)\s*:/; }
      close $fh;
   }
   else {
      open(my $fh,'>',$file) or die "No puedo crear $file: $!\n";
      print $fh "---\n# CNM Global Vars\n";
      close $fh;
   }

   open(my $fh,'>>',$file) or die "No puedo escribir $file: $!\n";
   my $added=0;
   for my $kv (@cfg) {
      next if $have{$kv->[0]};
      # booleanos YAML sin comillas (true/false); el resto entrecomillado
      if ($kv->[1] eq 'true' || $kv->[1] eq 'false') {
         print $fh "$kv->[0]: $kv->[1]\n";
      } else {
         print $fh "$kv->[0]: \"$kv->[1]\"\n";
      }
      $added++;
   }
   # ts_pwd: secreto. Se genera UNA vez si no existe (no se regenera en reruns).
   unless ($have{'ts_pwd'}) {
      my $pw = gen_pw(20);
      print $fh "ts_pwd: \"$pw\"\n"; $added++;
      print "[vars] ts_pwd generado y guardado en $file (guardalo: lo necesita el loader)\n";
   }
   close $fh;
   chmod 0600, $file;    # contiene ts_pwd -> solo root
   print "[vars] $file actualizado ($added claves nuevas de TimescaleDB)\n" if $added;
}

sub gen_pw {
   my ($n)=@_; $n||=20;
   my @c = ('A'..'Z','a'..'z','0'..'9');
   my $s=''; $s .= $c[int(rand(scalar @c))] for 1..$n;
   return $s;
}


#-------------------------------------------------------------------------------------------
sub create_script {
my ($script_file)=@_;

   local($/) = undef;  # slurp
	my $script_code = <DATA>;
	open (F,">$script_file");
	print F "$script_code\n";
	close F;
	chmod 0755, $script_file;
}

